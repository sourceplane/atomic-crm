{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vitest/globals",
      "node",
      "vite/client",
      "faker"
    ],
    "baseUrl": ".",
    "paths": {
      "@/test/*": [
        "./src/upstream/test/*"
      ],
      "@/*": [
        "../../apps/web/src/*"
      ],
      "@worker/*": [
        "../../apps/web/worker/*"
      ],
      "@app/*": [
        "../../apps/web/*"
      ],
      "cloudflare:workers": [
        "./src/stubs/cloudflare-workers.ts"
      ]
    }
  },
  "include": [
    "src",
    "vitest.config.ts",
    "vitest-browser.d.ts"
  ]
}
